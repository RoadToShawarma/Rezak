<Window x:Class="PosterMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PosterMaster"
        Title="Резак — печать плакатов" Icon="icon.ico" Width="1250" Height="830"
        MinWidth="1000" MinHeight="650" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragEnter="Window_PreviewDragOver"
        PreviewDragOver="Window_PreviewDragOver" PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ToolTip" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="PrintButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ButtonIcon" TargetType="Path">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
        <Style x:Key="FileIcon" TargetType="Path" BasedOn="{StaticResource ButtonIcon}">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Data" Value="M 1,1 H 15 L 22,8 V 26 H 1 Z M 15,1 V 8 H 22"/>
        </Style>
        <Style x:Key="FileIconLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style x:Key="ParameterHelp" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        </Style>
        <Style x:Key="HelpMark" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="?"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style x:Key="SpinButton" TargetType="RepeatButton" BasedOn="{StaticResource RoundedButtonBase}">
            <Setter Property="Width" Value="23"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>
        <Style x:Key="OrientationButton" TargetType="RadioButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EDF4FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#17233B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left" Orientation="Vertical">
                <TextBlock Text="Резак" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Плакат точного размера из листов А3 или А4" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Click="OpenSettings_Click"
                        AutomationProperties.Name="Настройки">
                    <Path Style="{StaticResource ButtonIcon}"
                          Data="M 10,2 H 14 L 14.6,5 A 7,7 0 0 1 16.2,5.9 L 19.1,4.9 L 21.2,8.5 L 19,10.5 A 7,7 0 0 1 19,13.5 L 21.2,15.5 L 19.1,19.1 L 16.2,18.1 A 7,7 0 0 1 14.6,19 L 14,22 H 10 L 9.4,19 A 7,7 0 0 1 7.8,18.1 L 4.9,19.1 L 2.8,15.5 L 5,13.5 A 7,7 0 0 1 5,10.5 L 2.8,8.5 L 4.9,4.9 L 7.8,5.9 A 7,7 0 0 1 9.4,5 Z M 15,12 A 3,3 0 1 0 9,12 A 3,3 0 1 0 15,12 Z"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="About_Click" Margin="0"
                        AutomationProperties.Name="О программе">
                    <Path Style="{StaticResource ButtonIcon}"
                          Data="M 21,12 A 9,9 0 1 0 3,12 A 9,9 0 1 0 21,12 Z M 12,11 V 16 M 12,8 V 8.2"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource AccentTintBrush}" CornerRadius="12"
                        MinWidth="100" Margin="8,0,0,0" Padding="14,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SheetCountText" Text="0" FontSize="36" FontWeight="Bold"
                                   Foreground="#1F457A" HorizontalAlignment="Center"
                                   AutomationProperties.LabeledBy="{Binding ElementName=SheetCountLabel}"/>
                        <TextBlock x:Name="SheetCountLabel" Text="листов" FontWeight="SemiBold"
                                   Foreground="#1F457A" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="Размеры и бумага" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"
                               Foreground="{StaticResource TextBrush}"/>
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Margin="0,0,14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ширина"/>
                                <Border Style="{StaticResource ParameterHelp}" ToolTip="Ширина готового изображения после сборки плаката.">
                                    <TextBlock Style="{StaticResource HelpMark}"/>
                                </Border>
                            </StackPanel>
                            <TextBox x:Name="PosterWidthBox" Text="100" Width="70" TextChanged="Settings_Changed"
                                     AutomationProperties.Name="Ширина плаката"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Высота"/>
                                <Border Style="{StaticResource ParameterHelp}" ToolTip="Высота готового изображения после сборки плаката.">
                                    <TextBlock Style="{StaticResource HelpMark}"/>
                                </Border>
                            </StackPanel>
                            <TextBox x:Name="PosterHeightBox" Text="50" Width="70" TextChanged="Settings_Changed"
                                     AutomationProperties.Name="Высота плаката"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ед. изм."/>
                                <Border Style="{StaticResource ParameterHelp}" ToolTip="Единицы для размеров плаката, полей и перекрытия. При смене значения пересчитываются.">
                                    <TextBlock Style="{StaticResource HelpMark}"/>
                                </Border>
                            </StackPanel>
                            <ComboBox x:Name="UnitsBox" Width="70" SelectionChanged="Units_Changed"
                                      AutomationProperties.Name="Единицы измерения размеров">
                                <ComboBoxItem Content="см" IsSelected="True"/>
                                <ComboBoxItem Content="мм"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Бумага"/>
                                <Border Style="{StaticResource ParameterHelp}" ToolTip="Формат каждого листа, на который разбивается плакат.">
                                    <TextBlock Style="{StaticResource HelpMark}"/>
                                </Border>
                            </StackPanel>
                            <ComboBox x:Name="PaperBox" Width="70" SelectionChanged="Settings_Changed"
                                      AutomationProperties.Name="Формат бумаги">
                                <ComboBoxItem Content="A4" IsSelected="True"/>
                                <ComboBoxItem Content="A3"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ориентация"/>
                                <Border Style="{StaticResource ParameterHelp}" ToolTip="Положение листа при печати — горизонтальное или вертикальное.">
                                    <TextBlock Style="{StaticResource HelpMark}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <RadioButton x:Name="LandscapeButton" GroupName="PaperOrientation" IsChecked="True"
                                             Style="{StaticResource OrientationButton}" Margin="0,0,4,0"
                                             Checked="Settings_Changed" ToolTip="Альбомная"
                                             AutomationProperties.Name="Альбомная ориентация">
                                    <Path Data="M 1,1 H 20 V 13 H 1 Z" Stroke="#1F457A" StrokeThickness="1.5"/>
                                </RadioButton>
                                <RadioButton x:Name="PortraitButton" GroupName="PaperOrientation"
                                             Style="{StaticResource OrientationButton}" Checked="Settings_Changed"
                                             ToolTip="Книжная" AutomationProperties.Name="Книжная ориентация">
                                    <Path Data="M 1,1 H 13 V 20 H 1 Z" Stroke="#1F457A" StrokeThickness="1.5"/>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Поля"/>
                                <Border Style="{StaticResource ParameterHelp}" ToolTip="Ширина белого отступа у каждого края листа. Стрелки меняют значение на 1 мм.">
                                    <TextBlock Style="{StaticResource HelpMark}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBox x:Name="MarginBox" Width="59" Margin="0,0,3,0" Text="0,8"
                                         TextChanged="Settings_Changed" AutomationProperties.Name="Поля"/>
                                <StackPanel>
                                    <RepeatButton Content="▲" Style="{StaticResource SpinButton}" Click="Spin_Click" Margin="0,0,0,2"
                                                  Tag="{Binding ElementName=MarginBox}" AutomationProperties.Name="Увеличить поля"/>
                                    <RepeatButton Content="▼" Style="{StaticResource SpinButton}" Click="Spin_Click"
                                                  Tag="{Binding ElementName=MarginBox}" AutomationProperties.Name="Уменьшить поля"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Перекрытие"/>
                                <Border Style="{StaticResource ParameterHelp}" ToolTip="Полоска изображения, которая повторяется на соседних листах для склейки внахлёст. Стрелки меняют значение на 1 мм.">
                                    <TextBlock Style="{StaticResource HelpMark}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBox x:Name="OverlapBox" Width="70" Margin="0,0,3,0" Text="0"
                                         TextChanged="Settings_Changed" AutomationProperties.Name="Перекрытие"/>
                                <StackPanel>
                                    <RepeatButton Content="▲" Style="{StaticResource SpinButton}" Click="Spin_Click" Margin="0,0,0,2"
                                                  Tag="{Binding ElementName=OverlapBox}" AutomationProperties.Name="Увеличить перекрытие"/>
                                    <RepeatButton Content="▼" Style="{StaticResource SpinButton}" Click="Spin_Click"
                                                  Tag="{Binding ElementName=OverlapBox}" AutomationProperties.Name="Уменьшить перекрытие"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Качество, DPI"/>
                                <Border Style="{StaticResource ParameterHelp}" ToolTip="Разрешение PNG и PDF. Большее значение даёт больше пикселей и увеличивает размер файлов.">
                                    <TextBlock Style="{StaticResource HelpMark}"/>
                                </Border>
                            </StackPanel>
                            <ComboBox x:Name="DpiBox" Width="70" SelectionChanged="Settings_Changed"
                                      AutomationProperties.Name="Качество, DPI">
                                <ComboBoxItem Content="150" />
                                <ComboBoxItem Content="200" />
                                <ComboBoxItem Content="300" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <DockPanel Margin="0,3,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <CheckBox x:Name="TrimMarksBox" Content="Метки обрезки" IsChecked="True"
                                      VerticalAlignment="Center" Click="Settings_Changed"/>
                            <Border Style="{StaticResource ParameterHelp}" ToolTip="Добавляет метки для обрезки листов в PDF и при печати.">
                                <TextBlock Style="{StaticResource HelpMark}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SourceInfo" Foreground="#64748B" Text="Изображение не загружено"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource AccentTintBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <TextBlock x:Name="SummaryText" Text="Загрузите изображение, чтобы увидеть раскладку."
                       TextWrapping="Wrap" Foreground="#1F457A" FontWeight="SemiBold"/>
        </Border>

        <Grid x:Name="ImageArea" Grid.Row="3" Background="Transparent">
            <Grid x:Name="ImagePreviews" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" x:Name="SelectionInfo" Foreground="#64748B"
                                   HorizontalAlignment="Right" Margin="8,3,8,10" Visibility="Collapsed"/>
                        <local:PosterPreview x:Name="WholePreview" MouseLeftButtonDown="WholePreview_Click"
                                             AutomationProperties.Name="Общий плакат"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                    <Grid x:Name="OriginalImagePanel">
                        <Border Background="#EBEEF3" CornerRadius="10"/>
                        <Image x:Name="OriginalImagePreview" Stretch="Uniform" Margin="12"
                               AutomationProperties.Name="Исходное изображение"/>
                        <Button Content="Заменить изображение" Click="Open_Click" Cursor="Hand"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=OriginalImagePanel}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                        </DataTrigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="AddImagePanel" Style="{StaticResource Card}" Padding="10">
                <Button Click="Open_Click" Margin="0" Background="#F6F9FE" Cursor="Hand"
                        AutomationProperties.Name="Добавить изображение">
                    <StackPanel>
                        <TextBlock Text="+" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Добавить изображение" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
            <Border x:Name="ImageDropHint" Style="{StaticResource Card}" Padding="10"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Grid>
                    <Rectangle Fill="{StaticResource AccentTintBrush}" Stroke="{StaticResource AccentBrush}"
                               StrokeThickness="2" StrokeDashArray="4 3" RadiusX="10" RadiusY="10"/>
                    <TextBlock Text="Перетащите изображение сюда" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock x:Name="StatusText" Text="Готово к работе" Foreground="#59677E"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="ExportProgress" Height="8" Margin="0,5,0,0"
                             Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                             AutomationProperties.Name="Ход сохранения"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ClearButton" Style="{StaticResource IconButton}" Click="Clear_Click"
                        IsEnabled="False" AutomationProperties.Name="Очистить">
                    <Path Style="{StaticResource ButtonIcon}"
                          Data="M 3,6 H 21 M 9,6 V 3 H 15 V 6 M 5,6 L 6,21 H 18 L 19,6 M 10,10 V 17 M 14,10 V 17"/>
                </Button>
                <StackPanel x:Name="OutputButtons" Orientation="Horizontal" IsEnabled="False">
                    <Button Style="{StaticResource IconButton}" Click="ExportFolder_Click"
                            AutomationProperties.Name="Сохранить страницы и схему в PNG">
                        <Grid>
                            <Path Style="{StaticResource FileIcon}"/>
                            <TextBlock Style="{StaticResource FileIconLabel}" Text="PNG"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="ExportPdf_Click"
                            AutomationProperties.Name="Сохранить PDF">
                        <Grid>
                            <Path Style="{StaticResource FileIcon}"/>
                            <TextBlock Style="{StaticResource FileIconLabel}" Text="PDF"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource PrintButton}" Click="Print_Click" Margin="0"
                            AutomationProperties.Name="Печать">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="M 7,8 V 2 H 17 V 8 M 7,17 H 2 V 8 H 22 V 17 H 17 M 7,14 H 17 V 22 H 7 Z M 18,11 H 19"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
