<Window x:Class="PosterMaster.ExportCompletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сохранение завершено" Icon="icon.ico" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="13" FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <StackPanel Margin="16">
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
                <Button x:Name="OpenFolderButton" Background="{StaticResource AccentTintBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" Padding="10,8" Margin="0,12,0,0"
                        HorizontalContentAlignment="Stretch" Cursor="Hand" ToolTip="Открыть папку"
                        AutomationProperties.Name="Открыть папку" Click="OpenFolder_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PathText" TextWrapping="Wrap" FontWeight="Normal"/>
                        <Viewbox Grid.Column="1" Width="18" Height="18" Margin="10,0,0,0"
                                 VerticalAlignment="Center" IsHitTestVisible="False">
                            <Canvas Width="48" Height="48">
                                <Path Fill="{StaticResource AccentBrush}"
                                      Data="M47.4,22l-5.88,16.66c-0.7,2-2.6,3.34-4.71,3.34H7c-2.76,0-5-2.24-5-5V8
                                            c0-1.65,1.35-3,3-3h8.14c1.53,0,2.9,0.85,3.58,2.21l1.62,3.24
                                            c0.17,0.34,0.51,0.55,0.9,0.55H38c2.21,0,4,1.79,4,4v1H17.83
                                            c-2.96,0-5.62,1.88-6.6,4.67L6.17,35c-0.18,0.52,0.09,1.09,0.61,1.28
                                            c0.11,0.04,0.22,0.05,0.33,0.05c0.42,0,0.8-0.25,0.95-0.66l5.06-14.33
                                            c0.7-2,2.59-3.34,4.71-3.34h26.74c0.97,0,1.89,0.47,2.45,1.27
                                            C47.58,20.06,47.73,21.08,47.4,22z"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
                <TextBlock x:Name="OpenFolderError" Visibility="Collapsed" TextWrapping="Wrap"
                           Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </Border>
        <Button x:Name="CloseButton" Content="ОК" Style="{StaticResource AccentButton}"
                IsDefault="True" IsCancel="True" Click="Close_Click" MinWidth="80"
                Margin="0" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
