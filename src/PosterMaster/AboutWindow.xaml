<Window x:Class="PosterMaster.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Icon="icon.ico" Width="390" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel>
        <DockPanel Margin="20,20,20,14">
            <Image DockPanel.Dock="Right" Width="56" Height="56" Stretch="Uniform" Source="icon.ico"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Резак" FontSize="26" FontWeight="Bold" Foreground="#17233B"/>
                <TextBlock x:Name="VersionText" Foreground="#5E6A80" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Margin="20,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Функционал:" TextAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="RoadToShawarma"/>
                <TextBlock Grid.Row="1" Text="Код:" TextAlignment="Right"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Codex"/>
                <TextBlock Grid.Row="2" Text="UI/UX:" TextAlignment="Right"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="RoadToShawarma, Codex"/>
                <TextBlock Grid.Row="3" Text="Страница проекта:" TextAlignment="Right"/>
                <TextBlock Grid.Row="3" Grid.Column="2">
                    <Hyperlink NavigateUri="https://github.com/RoadToShawarma/Rezak"
                               RequestNavigate="ProjectLink_RequestNavigate">GitHub</Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
        <TextBlock Text="Разбивает изображение на листы A4 или A3 для печати плаката заданного размера. Поддерживает экспорт в PNG, PDF, а также печать из программы."
                   TextWrapping="Wrap" Margin="20,16"/>
    </StackPanel>
</Window>
