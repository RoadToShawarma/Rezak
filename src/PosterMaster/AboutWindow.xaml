<Window x:Class="PosterMaster.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Icon="icon.ico" Width="390" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel>
        <DockPanel Margin="20,20,20,14">
            <Image DockPanel.Dock="Right" Width="56" Height="56" Stretch="Uniform" Source="icon.ico"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Резак" FontSize="26" FontWeight="Bold" Foreground="#17233B"/>
                <TextBlock x:Name="VersionText" Foreground="#5E6A80" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Margin="20,0" Padding="12">
            <StackPanel>
                <TextBlock Text="Функционал: RoadToShawarma"/>
                <TextBlock Text="Код: Codex"/>
                <TextBlock Text="UI/UX: RoadToShawarma, Codex"/>
            </StackPanel>
        </Border>
        <TextBlock Text="Разбивает изображение на листы A4 или A3 для печати плаката заданного размера. Поддерживает экспорт в PNG и PDF и печать из программы."
                   TextWrapping="Wrap" Margin="20,16"/>
        <Button Content="Закрыть" IsCancel="True" HorizontalAlignment="Right" Margin="0,0,20,20"/>
    </StackPanel>
</Window>
