<Window x:Class="PosterMaster.ReplacePngExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Замена PNG-экспорта" Icon="icon.ico" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="13" FocusManager.FocusedElement="{Binding ElementName=CancelButton}">
    <StackPanel Margin="16">
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Заменить файлы PNG-экспорта?" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="В этой папке уже есть пронумерованные PNG-фрагменты или схема сборки."
                           Margin="0,8,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                <Border Background="{StaticResource AccentTintBrush}" CornerRadius="8"
                        Padding="10,8" Margin="0,12,0,0">
                    <TextBlock x:Name="PathText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                </Border>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" IsDefault="True"/>
            <Button Content="Заменить" Style="{StaticResource AccentButton}" Click="Replace_Click" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
